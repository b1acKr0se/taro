@@ -0,0 +1,46 @@
+"""Command line: python -m sheetsite export POST_MD CSV_IN CSV_OUT [--raw]."""
+from __future__ import annotations
+
+import sys
+
+from minisheet.csvio import load_csv, save_csv
+
+from .bridge import widths_from_markdown
+
+USAGE = "usage: python -m sheetsite export POST_MD CSV_IN CSV_OUT [--raw]"
+
+
+def main(argv=None, stdout=None, stderr=None) -> int:
+    argv = list(sys.argv[1:] if argv is None else argv)
+    stdout = sys.stdout if stdout is None else stdout
+    stderr = sys.stderr if stderr is None else stderr
+
+    def usage() -> int:
+        stderr.write(USAGE + "\n")
+        return 2
+
+    if not argv or argv[0] != "export":
+        return usage()
+    raw = False
+    paths = []
+    for a in argv[1:]:
+        if a == "--raw":
+            raw = True
+        elif a.startswith("-"):
+            return usage()
+        else:
+            paths.append(a)
+    if len(paths) != 3:
+        return usage()
+    post, src, dst = paths
+    try:
+        with open(post, "rb") as f:
+            text = f.read().decode("utf-8")
+        widths = widths_from_markdown(text)
+        wb = load_csv(src)
+        save_csv(wb, dst, values=not raw, widths=widths)
+    except (OSError, ValueError) as e:
+        stderr.write(f"error: {e}\n")
+        return 1
+    stdout.write(f"exported: {len(widths)} sized columns\n")
+    return 0
