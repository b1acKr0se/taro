+"""Column widths for minisheet's CSV export, taken from sitegen front matter."""
+from __future__ import annotations
+
+from minisheet.csvio import parse_widths, to_csv_text
+from minisheet.workbook import Workbook
+from sitegen import frontmatter
+
+KEY = "csv_widths"
+
+
+def widths_from_meta(meta: dict) -> dict[int, int]:
+    if KEY not in meta:
+        return {}
+    value = meta[KEY]
+    if isinstance(value, str):
+        spec = value
+    elif isinstance(value, list) and all(isinstance(i, str) for i in value):
+        spec = ",".join(value)
+    else:
+        raise ValueError(f"{KEY}: must be a string or a list of strings")
+    try:
+        return parse_widths(spec)
+    except ValueError as e:
+        raise ValueError(f"{KEY}: {e}") from e
+
+
+def widths_from_markdown(text: str) -> dict[int, int]:
+    meta, _ = frontmatter.parse(text)
+    return widths_from_meta(meta)
+
+
+def export_csv(wb: Workbook, markdown_text: str, values: bool = True) -> str:
+    return to_csv_text(wb, values, widths=widths_from_markdown(markdown_text))
