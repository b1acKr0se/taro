{
  "name": "paseo-plugin-taro",
  "private": true,
  "version": "0.1.0",
  "description": "Agents work through your whole ticket board on their own: a manager files your requests as tickets, and owner agents take every one to completion, spawning subagents to build, test and review.",
  "license": "MIT",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "bin/",
    "server/",
    "shared/",
    "skill/",
    "templates/",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "!**/*.test.ts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude 'bench/tasks/**' --exclude '**/node_modules/**'"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@getpaseo/client": "0.11.2",
    "@getpaseo/plugin": "0.11.2",
    "@getpaseo/protocol": "0.11.2",
    "@tanstack/react-query": "^5.103.2",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "esbuild": "^0.28.2",
    "hermes-engine-cli": "^0.12.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-test-renderer": "^19.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  }
}
