#!/bin/sh
# The `taro` command: runs server/taro-cli.ts under plain Node type stripping (no npm packages).
# Resolves its own real location through symlinks, so the plugin's bin/ directory can sit on PATH
# or be linked from anywhere.
self=$0
while [ -h "$self" ]; do
  directory=$(cd "$(dirname "$self")" && pwd -P)
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$directory/$target ;;
  esac
done
directory=$(cd "$(dirname "$self")" && pwd -P)
# TARO_NODE is the daemon's own runtime, which is Electron when Paseo's desktop app runs the daemon:
# ELECTRON_RUN_AS_NODE makes it plain Node there (Node ignores it). The flag is needed before Node 22.18.
export ELECTRON_RUN_AS_NODE=1
exec "${TARO_NODE:-node}" --experimental-strip-types "$directory/../server/taro-cli.ts" "$@"
